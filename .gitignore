# Datos (no versionados; se regeneran desde raw/ + codigo)
# Excepcion: las firmas de referencia (.txt pequenos) en data/external/
# SI se comparten por git, porque el equipo las necesita sin descargar datos.
data/*
!data/external/
data/external/*
!data/external/*.txt
outputs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Entornos virtuales
.venv/
venv/
env/

# Variables de entorno / secretos
.env

# Escenas Sentinel-2 crudas
*.SAFE

# Salidas graficas y archivos comprimidos
*.png
*.zip

# Jupyter
.ipynb_checkpoints/

# Testing / cobertura
.pytest_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
