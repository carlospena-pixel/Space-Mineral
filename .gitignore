# Datos (no versionados; se regeneran desde raw/ + codigo)
# Excepcion: las firmas de referencia (.txt pequenos) en data/external/
# SI se comparten por git, porque el equipo las necesita sin descargar datos.
data/*
!data/external/
data/external/*
!data/external/*.txt

# data/external/geologia/ son los poligonos de la cartografia SERNAGEOMIN que
# construyen la verdad de terreno. Van al repo por el mismo motivo que las
# firmas .txt: son livianos (GeoJSON de unos pocos MB), no se regeneran desde
# ningun dato local --- se bajan de un servicio de terceros que puede cambiar o
# desaparecer--- y son la evidencia reproducible de contra que se valido.
!data/external/geologia/
data/external/geologia/*
!data/external/geologia/*.geojson
!data/external/geologia/*.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Entornos virtuales
.venv/
venv/
env/

# Variables de entorno / secretos
.env

# Escenas Sentinel-2 crudas
*.SAFE

# Salidas graficas y archivos comprimidos
*.png
*.zip

# Salidas: no se versionan, con una excepcion deliberada. Las figuras de
# outputs/figures/ SI van al repo porque son la evidencia de cada hito y el
# equipo las necesita sin tener que descargar la escena ni recomputar nada.
# Hay que negar carpeta por carpeta: si se ignorara `outputs/` completo, git
# ni siquiera desciende al directorio y ninguna negacion interna funcionaria.
# Esta despues de `*.png` a proposito: gana la ultima regla que casa.
outputs/*
!outputs/figures/
outputs/figures/*
!outputs/figures/*.png

# outputs/maps/ recibe los GeoTIFF del pipeline: la carpeta existe en el repo
# (via .gitkeep) para que un clon limpio pueda correr el pipeline sin crearla,
# pero los .tif no se versionan --se regeneran desde el config y pesan--.
!outputs/maps/
outputs/maps/*
!outputs/maps/.gitkeep

# outputs/scratch/ es el destino de las salidas exploratorias: la carpeta
# existe en el repo (via .gitkeep) para que los scripts puedan escribir ahi
# sin crearla, pero nada de lo que se genere dentro se versiona.
!outputs/scratch/
outputs/scratch/*
!outputs/scratch/.gitkeep

# Jupyter
.ipynb_checkpoints/

# Testing / cobertura
.pytest_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# docs/recorrido/ es el recorrido explicativo del proyecto: capitulos en
# markdown, sus imagenes y el HTML compilado. NO se versiona por decision
# explicita (2026-08-18): es material de estudio propio, no parte del
# entregable, y el HTML compilado pesa 2,1 MB que no aportan a un clon.
# Se ignora la carpeta completa. Ojo: una vez excluido el directorio, git ni
# siquiera desciende a el, asi que cualquier negacion interna (por ejemplo
# `!docs/recorrido/imagenes/*.png`, que estaba aca para salvar las figuras de
# la regla `*.png`) queda muerta. Por eso se elimino en vez de dejarla.
# Si algun dia el recorrido se publica, hay que quitar esta regla entera.
docs/recorrido/
